{
  "name": "api-traceability",
  "version": "0.1.0",
  "private": true,
  "description": "Parse Java/Spring microservices from Bitbucket and trace every REST endpoint upstream and downstream",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "analyze": "tsx server/src/cli.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tree-sitter-java": "0.23.5",
    "web-tree-sitter": "0.25.10",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.3.6",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
