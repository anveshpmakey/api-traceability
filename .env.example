PORT=4000
# Where scans and cloned repos are stored
DATA_DIR=data
# Optional server-side Bitbucket credentials (used when the scan form leaves credentials blank)
# Bitbucket Cloud: repository/project/workspace access token, or username + app password / API token
# Bitbucket Data Center: HTTP access token, or username + password
BITBUCKET_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
# Comma-separated folders the "Local folders" scan type may read (default: ./samples)
LOCAL_SCAN_ROOTS=
# Set to 0 to skip the demo scan of ./samples on first start
DEMO_SCAN=1
